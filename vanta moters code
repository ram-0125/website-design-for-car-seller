<div id="toast"><div class="glass px-5 py-3 rounded-xl text-[13px] font-semibold flex items-center gap-2.5" style="background:rgba(18,21,26,.92)"><span class="w-2 h-2 rounded-full" style="background:#3DFF88;box-shadow:0 0 10px #3DFF88"></span><span id="toastMsg">Saved</span></div></div>

<script>
function toast(m){const t=document.getElementById('toast');document.getElementById('toastMsg').textContent=m;t.classList.add('show');clearTimeout(t._h);t._h=setTimeout(()=>t.classList.remove('show'),2600)}
function selectCard(el,group,msg){document.querySelectorAll('#'+group+' .selectable').forEach(c=>{c.classList.remove('selected');const b=c.querySelector('.chip');});el.classList.add('selected');if(msg)toast(msg)}
// paint
const dots=document.querySelectorAll('.paint-dot');
dots.forEach(d=>d.addEventListener('click',()=>{
  dots.forEach(x=>x.classList.remove('active'));d.classList.add('active');
  document.getElementById('paintName').textContent=d.dataset.name;
  document.getElementById('paintCode').textContent=d.dataset.code+' · 7-LAYER + CERAMIC';
  document.getElementById('platePaint').textContent=d.dataset.code+' '+d.dataset.name.toUpperCase().slice(0,8);
  const wash=document.getElementById('paintWash');
  wash.style.background=`linear-gradient(115deg, ${d.dataset.c2}88, transparent 60%), radial-gradient(80% 60% at 80% 20%, ${d.dataset.c1}55, transparent 60%)`;
  toast(d.dataset.name+' applied — booth 04');
}));
// counters
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){anim(e.target);io.unobserve(e.target)}}),{threshold:.4});
document.querySelectorAll('.count').forEach(el=>io.observe(el));
function anim(el){const to=parseFloat(el.dataset.to),dec=parseInt(el.dataset.dec||0);let s=performance.now(),d=1400;function f(t){let p=Math.min(1,(t-s)/d);p=1-Math.pow(1-p,3);el.textContent=(to*p).toFixed(dec);if(p<1)requestAnimationFrame(f)}requestAnimationFrame(f)}
// tilt + glare
const hero=document.getElementById('heroCard');
hero.addEventListener('mousemove',e=>{
  const r=hero.getBoundingClientRect(),x=(e.clientX-r.left)/r.width,y=(e.clientY-r.top)/r.height;
  hero.style.transform=`perspective(1200px) rotateY(${(x-.5)*6}deg) rotateX(${(.5-y)*5}deg)`;
  hero.style.setProperty('--gx',(x*100)+'%');hero.style.setProperty('--gy',(y*100)+'%');
});
hero.addEventListener('mouseleave',()=>hero.style.transform='perspective(1200px) rotateY(0) rotateX(0)');
// rev
let revving=false;
function revEngine(){
  if(revving)return;revving=true;
  const btn=document.getElementById('startBtn'),val=document.getElementById('rpmVal');
  btn.textContent='◉ IGNITION...';let rpm=900,t0=performance.now();
  toast('Titanium exhaust — valves open');
  function tick(t){
    let p=(t-t0)/2600;
    if(p>=1){val.textContent='900';btn.textContent='● HOLD TO START';revving=false;return}
    rpm=900+Math.sin(p*18)*800+p*6200*Math.sin(p*Math.PI);
    val.textContent=Math.max(800,Math.round(rpm)).toLocaleString('en-US');
    requestAnimationFrame(tick)
  }
  requestAnimationFrame(tick)
}
setInterval(()=>{document.getElementById('clock').textContent=new Date().toLocaleTimeString('en-GB')},1000);
document.querySelectorAll('.tab').forEach(t=>t.addEventListener('click',()=>{document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));t.classList.add('active')}));
</script>
